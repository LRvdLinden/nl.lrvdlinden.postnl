{
  "id": "nl.lrvdlinden.postnl",
  "version": "0.1.16",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "PostNL",
    "nl": "PostNL"
  },
  "description": {
    "en": "See incoming mail and PostNL parcels in Homey, with widgets and Flow cards.",
    "nl": "Bekijk verwachte post en PostNL-pakketten in Homey, met widgets en Flow-kaarten."
  },
  "category": [
    "internet"
  ],
  "brandColor": "#FB6200",
  "author": {
    "name": "Léon van der Linden",
    "email": "homey@vdlinden.xyz"
  },
  "copyright": "Léon van der Linden",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/LRvdLinden/nl.lrvdlinden.postnl",
  "support": "mailto:homey@vdlinden.xyz",
  "bugs": {
    "url": "https://github.com/LRvdLinden/nl.lrvdlinden.postnl/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "permissions": [],
  "api": {
    "sync": {
      "method": "POST",
      "path": "/sync"
    },
    "status": {
      "method": "GET",
      "path": "/status"
    },
    "authStatus": {
      "method": "GET",
      "path": "/auth/status"
    },
    "startAuth": {
      "method": "POST",
      "path": "/auth/start"
    },
    "completeAuth": {
      "method": "POST",
      "path": "/auth/complete"
    },
    "logout": {
      "method": "POST",
      "path": "/auth/logout"
    }
  },
  "widgets": {
    "mijn-post": {
      "id": "mijn-post",
      "name": {
        "en": "My PostNL",
        "nl": "Mijn PostNL"
      },
      "height": 360,
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        },
        "sync": {
          "method": "POST",
          "path": "/sync"
        }
      },
      "settings": [
        {
          "id": "maximumItems",
          "type": "number",
          "value": 5,
          "min": 1,
          "max": 5,
          "step": 1,
          "title": {
            "en": "Items per category",
            "nl": "Items per categorie"
          }
        }
      ],
      "devices": {
        "type": "app",
        "singular": false,
        "filter": {
          "capabilities": "postnl_mail_count"
        }
      }
    }
  }
}
