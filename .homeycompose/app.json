{
  "id": "nl.lrvdlinden.postnl",
  "version": "1.1.3",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "PostNL",
    "nl": "PostNL"
  },
  "description": {
    "en": "See incoming mail and PostNL parcels in Homey, with widgets and Flow cards.",
    "nl": "Bekijk verwachte post en PostNL-pakketten in Homey, met widgets en Flow-kaarten."
  },
  "category": [
    "internet"
  ],
  "brandColor": "#FB6200",
  "author": {
    "name": "Léon van der Linden",
    "email": "homey@vdlinden.xyz"
  },
  "copyright": "Léon van der Linden",
  "license": "GPL-3.0-or-later",
  "homepage": "https://lrvdlinden.app",
  "support": "https://community.homey.app/t/app-pro-postnl-for-homey/159674",
  "bugs": {
    "url": "https://community.homey.app/t/app-pro-postnl-for-homey/159674"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "widgets": {
    "mijn-post": {
      "id": "mijn-post",
      "name": {
        "en": "My Post",
        "nl": "Mijn Post"
      },
      "height": 250,
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        },
        "sync": {
          "method": "POST",
          "path": "/sync"
        }
      },
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "postnl_mail_count"
        }
      }
    },
    "mijn-pakket": {
      "id": "mijn-pakket",
      "name": {
        "en": "My Package",
        "nl": "Mijn Pakket"
      },
      "height": 360,
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        },
        "sync": {
          "method": "POST",
          "path": "/sync"
        }
      },
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "capabilities": "postnl_package_count"
        }
      }
    }
  },
  "homeyCommunityTopicId": 159674,
  "tags": {
    "en": [
      "postnl",
      "post",
      "mail",
      "letter",
      "letters",
      "mail item",
      "mail items",
      "parcel",
      "parcels",
      "package",
      "packages",
      "package tracking",
      "parcel tracking",
      "delivery",
      "deliveries",
      "shipment",
      "shipments",
      "tracking",
      "track and trace",
      "postal service",
      "postal delivery",
      "my post",
      "my package",
      "mailbox",
      "automation"
    ],
    "nl": [
      "postnl",
      "post",
      "brief",
      "brieven",
      "poststuk",
      "poststukken",
      "pakket",
      "pakketten",
      "pakket volgen",
      "pakketten volgen",
      "bezorging",
      "bezorgen",
      "zending",
      "zendingen",
      "tracking",
      "track en trace",
      "postbezorging",
      "mijn post",
      "mijn pakket",
      "brievenbus",
      "automatisering"
    ]
  }
}
