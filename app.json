{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.lrvdlinden.postnl",
  "version": "0.1.14",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "PostNL",
    "nl": "PostNL"
  },
  "description": {
    "en": "See incoming mail and PostNL parcels in Homey, with widgets and Flow cards.",
    "nl": "Bekijk verwachte post en PostNL-pakketten in Homey, met widgets en Flow-kaarten."
  },
  "category": [
    "internet"
  ],
  "brandColor": "#FB6200",
  "author": {
    "name": "Léon van der Linden",
    "email": "homey@vdlinden.xyz"
  },
  "copyright": "Léon van der Linden",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/LRvdLinden/nl.lrvdlinden.postnl",
  "support": "mailto:homey@vdlinden.xyz",
  "bugs": {
    "url": "https://github.com/LRvdLinden/nl.lrvdlinden.postnl/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "permissions": [],
  "api": {
    "sync": { "method": "POST", "path": "/sync" },
    "status": { "method": "GET", "path": "/status" },
    "authStatus": { "method": "GET", "path": "/auth/status" },
    "startAuth": { "method": "POST", "path": "/auth/start" },
    "completeAuth": { "method": "POST", "path": "/auth/complete" },
    "logout": { "method": "POST", "path": "/auth/logout" }
  },
  "widgets": {
    "mijn-post": {
      "name": { "en": "My PostNL", "nl": "Mijn PostNL" },
      "height": 240,
      "api": {
        "getData": { "method": "GET", "path": "/" },
        "sync": { "method": "POST", "path": "/sync" }
      },
      "settings": [
        { "id": "maximumItems", "type": "number", "value": 3, "min": 1, "max": 6, "step": 1, "title": { "en": "Maximum mail items", "nl": "Maximaal aantal poststukken" } },
        { "id": "historyDays", "type": "number", "value": 1, "min": 1, "max": 14, "step": 1, "title": { "en": "Number of days", "nl": "Aantal dagen" } }
      ],
      "devices": { "type": "app", "singular": false, "filter": { "capabilities": "postnl_mail_count" } },
      "id": "mijn-post"
    }
  },
  "flow": {
    "triggers": [
      { "id": "new_mail", "title": { "en": "New mail is expected", "nl": "Er is nieuwe post onderweg" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }], "tokens": [{ "name": "count", "type": "number", "title": { "en": "Number of mail items", "nl": "Aantal poststukken" } }, { "name": "date", "type": "string", "title": { "en": "Delivery date", "nl": "Bezorgdatum" } }] },
      { "id": "new_package", "title": { "en": "A new parcel was found", "nl": "Er is een nieuw pakket gevonden" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }], "tokens": [{ "name": "title", "type": "string", "title": { "en": "Parcel", "nl": "Pakket" } }, { "name": "status", "type": "string", "title": { "en": "Status", "nl": "Status" } }, { "name": "delivery_window", "type": "string", "title": { "en": "Delivery window", "nl": "Bezorgvenster" } }] },
      { "id": "package_status_changed", "title": { "en": "A parcel status changed", "nl": "De status van een pakket is gewijzigd" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }], "tokens": [{ "name": "title", "type": "string", "title": { "en": "Parcel", "nl": "Pakket" } }, { "name": "status", "type": "string", "title": { "en": "Status", "nl": "Status" } }, { "name": "delivery_window", "type": "string", "title": { "en": "Delivery window", "nl": "Bezorgvenster" } }] },
      { "id": "sync_failed", "title": { "en": "PostNL synchronization failed", "nl": "PostNL-synchronisatie is mislukt" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }], "tokens": [{ "name": "error", "type": "string", "title": { "en": "Error", "nl": "Foutmelding" } }] },
      { "id": "login_expired", "title": { "en": "The PostNL login expired", "nl": "De PostNL-aanmelding is verlopen" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }] }
    ],
    "conditions": [
      { "id": "mail_expected", "title": { "en": "Mail is expected", "nl": "Er wordt post verwacht" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }] },
      { "id": "packages_underway", "title": { "en": "Parcels are underway", "nl": "Er zijn pakketten onderweg" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }] }
    ],
    "actions": [
      { "id": "sync_now", "title": { "en": "Synchronize PostNL", "nl": "Synchroniseer PostNL" }, "args": [{ "type": "device", "name": "device", "filter": "driver_id=account" }] }
    ]
  },
  "drivers": [
    { "name": { "en": "My PostNL", "nl": "Mijn PostNL" }, "class": "sensor", "capabilities": ["postnl_mail_expected", "postnl_mail_count", "postnl_package_count", "postnl_next_delivery", "postnl_status", "postnl_last_update"], "platforms": ["local"], "images": { "small": "/drivers/account/assets/images/small.png", "large": "/drivers/account/assets/images/large.png" }, "pair": [{ "id": "check_login", "navigation": { "next": "list_devices" } }, { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } }, { "id": "add_devices", "template": "add_devices" }], "id": "account" }
  ],
  "capabilities": {
    "postnl_last_update": { "type": "string", "title": { "en": "Last update", "nl": "Laatste update" }, "getable": true, "setable": false, "insights": false, "icon": "/assets/clock.svg" },
    "postnl_mail_count": { "type": "number", "title": { "en": "Mail items", "nl": "Poststukken" }, "getable": true, "setable": false, "decimals": 0, "insights": true, "icon": "/assets/mail.svg" },
    "postnl_mail_expected": { "type": "boolean", "title": { "en": "Mail expected", "nl": "Post verwacht" }, "getable": true, "setable": false, "uiComponent": "sensor", "insights": true, "icon": "/assets/mail.svg" },
    "postnl_next_delivery": { "type": "string", "title": { "en": "Next delivery", "nl": "Volgende bezorging" }, "getable": true, "setable": false, "insights": false, "icon": "/assets/calendar.svg" },
    "postnl_package_count": { "type": "number", "title": { "en": "Parcels underway", "nl": "Pakketten onderweg" }, "getable": true, "setable": false, "decimals": 0, "insights": true, "icon": "/assets/package.svg" },
    "postnl_status": { "type": "string", "title": { "en": "Status", "nl": "Status" }, "getable": true, "setable": false, "insights": false, "icon": "/assets/status.svg" }
  }
}
