{
  "manifest_version": 3,
  "name": "PostNL Homey Login Helper",
  "description": "Vangt de PostNL OAuth-callback veilig op zodat deze in de Homey App Settings kan worden geplakt.",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.postnl.nl/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "PostNL Homey Login Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
