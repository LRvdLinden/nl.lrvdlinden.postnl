{
  "name": { "en": "My Mail", "nl": "Mijn Post" },
  "height": 240,
  "api": {
    "getData": { "method": "GET", "path": "/" },
    "sync": { "method": "POST", "path": "/sync" }
  },
  "settings": [
    {
      "id": "maximumItems",
      "type": "number",
      "value": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "title": { "en": "Maximum mail items", "nl": "Maximaal aantal poststukken" }
    },
    {
      "id": "historyDays",
      "type": "number",
      "value": 1,
      "min": 1,
      "max": 14,
      "step": 1,
      "title": { "en": "Number of days", "nl": "Aantal dagen" }
    }
  ],
  "devices": {
    "type": "app",
    "singular": false,
    "filter": { "capabilities": "postnl_mail_count" }
  }
}
