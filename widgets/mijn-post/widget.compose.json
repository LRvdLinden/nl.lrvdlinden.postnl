{
  "name": {
    "en": "My PostNL",
    "nl": "Mijn PostNL"
  },
  "height": 360,
  "api": {
    "getData": {
      "method": "GET",
      "path": "/"
    },
    "sync": {
      "method": "POST",
      "path": "/sync"
    }
  },
  "settings": [
    {
      "id": "maximumItems",
      "type": "number",
      "value": 5,
      "min": 1,
      "max": 5,
      "step": 1,
      "title": {
        "en": "Items per category",
        "nl": "Items per categorie"
      }
    }
  ],
  "devices": {
    "type": "app",
    "singular": false,
    "filter": {
      "capabilities": "postnl_mail_count"
    }
  }
}
